+    @torch.no_grad()
+    def _extract_contextual_prefix_hidden(
+        self, gen: dict[str, torch.Tensor]
+    ) -> ContextualPrefixHidden:
+        """Run a no-cache HF prefix forward and detach only attention-valid rows."""
+        model = self.bundle.model
+        # Reuse the exact position-id preparation used by ``generate``.  Recent
+        # Qwen3-VL releases require ``mm_token_type_ids`` when position ids are
+        # absent, while this checkpoint's processor path intentionally omits
+        # them and generation falls back to text positions for every RoPE axis.
+        # Calling the model's generation helper preserves that baseline instead
+        # of introducing a different multimodal-position convention only for
+        # the exported hidden state.
+        prepare_positions = getattr(model, "_prepare_position_ids_for_generation", None)
+        forward_inputs = dict(gen)
+        has_multimodal_grid = any(
+            gen.get(name) is not None for name in ("image_grid_thw", "video_grid_thw")
+        )
+        if callable(prepare_positions):
+            position_ids = prepare_positions(gen["input_ids"], dict(gen))
+            if not isinstance(position_ids, torch.Tensor):
+                raise RuntimeError("HF generation position-id preparation returned no tensor")
+            forward_inputs["position_ids"] = position_ids
+        elif has_multimodal_grid:
+            raise RuntimeError("multimodal HF model lacks generation position-id preparation")
+        with torch.inference_mode():
+            outputs = model(
+                **forward_inputs,
+                output_hidden_states=True,
+                use_cache=False,
+                return_dict=True,
+            )
+        hidden_states = getattr(outputs, "hidden_states", None)
+        if not hidden_states:
+            raise RuntimeError("HF model did not return hidden_states for the prefix forward")
+        final_hidden = hidden_states[-1]
+        if final_hidden.ndim != 3 or final_hidden.shape[0] != 1:
+            raise RuntimeError(
+                "expected final prefix hidden shape [1, seq, hidden], got "
+                f"{tuple(final_hidden.shape)}"
+            )
+        input_ids = gen["input_ids"][0]
+        attention_mask = gen.get("attention_mask")
+        if attention_mask is None:
+            mask = torch.ones(input_ids.shape[0], dtype=torch.bool, device=input_ids.device)
+        else:
+            mask = attention_mask[0].to(dtype=torch.bool)
+        if final_hidden.shape[1] != mask.numel() or input_ids.numel() != mask.numel():
+            raise RuntimeError(
+                "prefix hidden/input/mask length mismatch: "
+                f"hidden={final_hidden.shape[1]} input={input_ids.numel()} mask={mask.numel()}"
+            )
+        valid_indices = mask.nonzero(as_tuple=False).flatten()
+        if valid_indices.numel() == 0:
+            raise RuntimeError("prefix attention mask contains no valid tokens")
+        video_grid = gen.get("video_grid_thw")
+        return ContextualPrefixHidden(
